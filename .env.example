# Copy to .env and fill in the blanks — bootstrap.sh does this for you and
# auto-generates the secrets. .env is gitignored; never commit it.

# ---- AffiNE server ----
# Host port for the AffiNE web UI
PORT=3010

# Bind-mount locations for uploads & config. ${HOME} is expanded by Compose.
# (Postgres data lives in the runtime-managed named volume `affine_pgdata`, not here —
#  a host bind mount can't satisfy both Docker and rootless Podman UID mapping.)
UPLOAD_LOCATION=${HOME}/.affine/self-host/storage
CONFIG_LOCATION=${HOME}/.affine/self-host/config

# ---- Database ----
DB_USERNAME=affine
DB_PASSWORD=            # auto-generated by bootstrap.sh
DB_DATABASE=affine

# ---- AffiNE MCP server (affine-mcp-server submodule, HTTP transport) ----
# Host port for the MCP HTTP endpoint (must differ from PORT)
MCP_PORT=3011
# Shared bearer secret MCP clients send as "Authorization: Bearer <token>" — auto-generated
AFFINE_MCP_HTTP_TOKEN=
# Auth to the LOCAL AffiNE. Create this account in the web UI at http://localhost:${PORT}
# on first run; bootstrap.sh writes these for you. A token (optional) takes priority.
AFFINE_API_TOKEN=
AFFINE_EMAIL=
AFFINE_PASSWORD=
# Tool surface exposed by the MCP server: full | read_only | core | authoring
AFFINE_TOOL_PROFILE=full
